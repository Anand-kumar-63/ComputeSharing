# -------------------------
# Backend & General Configs
# -------------------------
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
MONGO_URI=mongodb://mongodb:27017/gpushare
REDIS_URL=redis://redis:6379

JWT_SECRET=your_jwt_secret_key_here
# Passphrase used to encrypt stored host API keys. At least 16 bytes; use a long
# random secret. Changing it makes previously stored API keys undecryptable.
ENCRYPTION_KEY=your_long_random_encryption_secret_here

# Set to "true" only for single-machine setups where the GPU agent runs on the
# same host as the backend. Otherwise loopback agent addresses are rejected,
# because the backend makes server-side requests to whatever a host registers.
ALLOW_LOOPBACK_AGENT_IPS=

# Object Storage (S3 / MinIO / R2)
OBJECT_STORAGE_BUCKET=your_bucket_name
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=your_access_key
OBJECT_STORAGE_SECRET_ACCESS_KEY=your_secret_key

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# AI APIs
GEMINI_API_KEY=your_gemini_api_key

# -------------------------
# Frontend Configs
# -------------------------
VITE_API_URL=http://localhost:5000/api
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# -------------------------
# Agent Configs
# -------------------------
BACKEND_URL=http://localhost:5000
AGENT_PORT=7000
AGENT_JWT_TOKEN=
PRICE_PER_HOUR=0.5
